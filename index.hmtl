<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#070b18" />
  <meta name="description" content="Eugine Fx (Derixassistbothub) — Join our community and follow us on Facebook and TikTok." />
  <title>Eugine Fx (Derixassistbothub) | Join the Community</title>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #070b18;
      --card: rgba(255,255,255,.07);
      --text: #f8fafc;
      --muted: #aab4ca;
      --accent: #7c3aed;
      --accent2: #06b6d4;
      --pink: #ec4899;
      --border: rgba(255,255,255,.13);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 15% 20%, rgba(124,58,237,.24), transparent 28%),
        radial-gradient(circle at 85% 15%, rgba(6,182,212,.18), transparent 25%),
        var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }

    .orb {
      position: fixed;
      width: 320px;
      height: 320px;
      border-radius: 50%;
      filter: blur(80px);
      opacity: .18;
      pointer-events: none;
      z-index: -1;
      animation: float 10s ease-in-out infinite;
    }
    .orb.one { background: #7c3aed; top: 8%; left: -120px; }
    .orb.two { background: #06b6d4; right: -120px; bottom: 5%; animation-delay: -4s; }

    @keyframes float {
      0%,100% { transform: translate(0,0) scale(1); }
      50% { transform: translate(35px,-25px) scale(1.08); }
    }

    nav {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 20;
      padding: 18px 6%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(7,11,24,.62);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(255,255,255,.06);
    }

    .logo {
      font-size: 1.35rem;
      font-weight: 900;
      letter-spacing: .5px;
    }
    .logo span { color: #a78bfa; }

    .nav-btn {
      padding: 10px 17px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,.06);
      font-weight: 700;
      transition: .25s;
    }
    .nav-btn:hover { transform: translateY(-2px); background: rgba(255,255,255,.12); }

    .hero {
      min-height: 100vh;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 130px 20px 70px;
      position: relative;
    }

    .hero-inner { max-width: 900px; animation: reveal .9s ease both; }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: rgba(255,255,255,.055);
      color: #d8d3ff;
      font-size: .9rem;
      margin-bottom: 24px;
    }
    .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 15px #22c55e;
      animation: pulse 1.6s infinite;
    }
    @keyframes pulse { 50% { opacity: .35; transform: scale(.65); } }

    h1 {
      font-size: clamp(3.2rem, 9vw, 7.5rem);
      line-height: .92;
      letter-spacing: -5px;
      margin-bottom: 24px;
      background: linear-gradient(110deg, #fff 15%, #c4b5fd 48%, #67e8f9 85%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: glow 4s ease-in-out infinite alternate;
    }
    @keyframes glow { to { filter: drop-shadow(0 0 25px rgba(124,58,237,.25)); } }

    .hero p {
      max-width: 680px;
      margin: auto;
      color: var(--muted);
      font-size: clamp(1rem, 2vw, 1.2rem);
      line-height: 1.75;
    }

    .actions {
      margin-top: 35px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 13px;
    }

    .btn {
      border: 0;
      cursor: pointer;
      padding: 15px 22px;
      border-radius: 14px;
      font-weight: 800;
      font-size: 1rem;
      transition: transform .25s, box-shadow .25s, background .25s;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .btn:hover { transform: translateY(-4px); }

    .primary {
      color: white;
      background: linear-gradient(135deg, #7c3aed, #4f46e5);
      box-shadow: 0 12px 35px rgba(124,58,237,.35);
    }
    .facebook { background: #1877f2; color: #fff; box-shadow: 0 10px 28px rgba(24,119,242,.25); }
    .tiktok { background: #111827; color: #fff; border: 1px solid #374151; box-shadow: 0 10px 28px rgba(0,0,0,.25); }

    .section {
      padding: 90px 6%;
      max-width: 1150px;
      margin: auto;
    }

    .section-title { text-align: center; margin-bottom: 45px; }
    .section-title h2 { font-size: clamp(2rem, 5vw, 3.2rem); margin-bottom: 12px; }
    .section-title p { color: var(--muted); }

    .cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }

    .card {
      padding: 34px;
      border-radius: 24px;
      background: var(--card);
      border: 1px solid var(--border);
      backdrop-filter: blur(16px);
      transition: transform .3s, border-color .3s, box-shadow .3s;
      animation: reveal .8s ease both;
    }
    .card:hover {
      transform: translateY(-8px);
      border-color: rgba(167,139,250,.55);
      box-shadow: 0 25px 70px rgba(0,0,0,.25);
    }

    .icon {
      width: 58px; height: 58px;
      display: grid; place-items: center;
      border-radius: 17px;
      font-size: 1.65rem;
      margin-bottom: 20px;
      background: linear-gradient(135deg, rgba(124,58,237,.3), rgba(6,182,212,.2));
      border: 1px solid var(--border);
    }

    .card h3 { font-size: 1.45rem; margin-bottom: 10px; }
    .card p { color: var(--muted); line-height: 1.7; margin-bottom: 22px; }

    .card a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-weight: 800;
      color: #c4b5fd;
    }
    .card a:hover { color: #fff; }

    .join {
      text-align: center;
      margin: 30px auto 90px;
      max-width: 950px;
      padding: 65px 25px;
      border-radius: 30px;
      border: 1px solid var(--border);
      background: linear-gradient(135deg, rgba(124,58,237,.15), rgba(6,182,212,.08));
      position: relative;
      overflow: hidden;
    }
    .join::before {
      content: "";
      position: absolute;
      width: 180px; height: 180px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 50%;
      left: -50px; top: -70px;
      animation: spin 12s linear infinite;
    }
    .join h2 { font-size: clamp(2rem, 5vw, 3.3rem); margin-bottom: 14px; }
    .join p { color: var(--muted); max-width: 650px; margin: auto; line-height: 1.7; }

    footer {
      text-align: center;
      padding: 35px 20px;
      color: #7f8ba5;
      border-top: 1px solid rgba(255,255,255,.07);
      font-size: .9rem;
    }

    .reveal { opacity: 0; transform: translateY(30px); transition: .8s ease; }
    .reveal.show { opacity: 1; transform: translateY(0); }

    @keyframes reveal {
      from { opacity: 0; transform: translateY(22px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 700px) {
      nav { padding: 15px 5%; }
      .cards { grid-template-columns: 1fr; }
      .card { padding: 27px; }
      h1 { letter-spacing: -3px; }
      .btn { width: 100%; justify-content: center; }
      .actions { width: min(420px, 100%); margin-left: auto; margin-right: auto; }
    }
  </style>
</head>

<body>
  <div class="orb one"></div>
  <div class="orb two"></div>

  <nav>
    <a href="#" class="logo">Eugine<span> Fx</span></a>
    <a href="#join" class="nav-btn">Join Us</a>
  </nav>

  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="badge"><span class="dot"></span> Welcome to Eugine Fx (Derixassistbothub)</div>
        <h1>Eugine Fx<br />(Derixassistbothub)</h1>
        <p>
          Join our growing community, stay connected, and follow Eugine Fx (Derixassistbothub)
          across social media for the latest content, updates and moments.
        </p>

        <div class="actions">
          <a class="btn primary" href="#join">✨ Join the Community</a>
          <a class="btn facebook" href="https://www.facebook.com/goose.347880"
             target="_blank" rel="noopener noreferrer">👍 Facebook</a>
          <a class="btn tiktok" href="https://www.tiktok.com/@www.eugyfx.com?_r=1&_t=ZS-9AIUjsBNwqT"
             target="_blank" rel="noopener noreferrer">♪ TikTok</a>
        </div>
      </div>
    </section>

    <section class="section" id="follow">
      <div class="section-title reveal">
        <h2>Connect With Eugine Fx</h2>
        <p>Follow, join and never miss what is coming next.</p>
      </div>

      <div class="cards">
        <article class="card reveal">
          <div class="icon">👍</div>
          <h3>Follow on Facebook</h3>
          <p>
            Connect with Eugine Fx (Derixassistbothub) on Facebook and keep up with posts,
            announcements and community updates.
          </p>
          <a href="https://www.facebook.com/goose.347880" target="_blank" rel="noopener noreferrer">
            Open Facebook <span>→</span>
          </a>
        </article>

        <article class="card reveal">
          <div class="icon">♪</div>
          <h3>Follow on TikTok</h3>
          <p>
            Follow the Eugine Fx (Derixassistbothub) TikTok profile for new videos, entertainment
            and fresh content.
          </p>
          <a href="https://www.tiktok.com/@www.eugyfx.com?_r=1&_t=ZS-9AIUjsBNwqT"
             target="_blank" rel="noopener noreferrer">
            Open TikTok <span>→</span>
          </a>
        </article>
      </div>
    </section>

    <section class="join reveal" id="join">
      <h2>Ready to Join?</h2>
      <p>
        Become part of the Eugine Fx (Derixassistbothub) community. Choose your favorite platform
        below and follow the official pages.
      </p>

      <div class="actions">
        <a class="btn facebook" href="https://www.facebook.com/goose.347880"
           target="_blank" rel="noopener noreferrer">👍 Join on Facebook</a>
        <a class="btn tiktok" href="https://www.tiktok.com/@www.eugyfx.com?_r=1&_t=ZS-9AIUjsBNwqT"
           target="_blank" rel="noopener noreferrer">♪ Follow on TikTok</a>
      </div>
    </section>
  </main>

  <footer>
    © <span id="year"></span> Eugine Fx (Derixassistbothub). All rights reserved.
  </footer>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("show");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  </script>
</body>
</html>